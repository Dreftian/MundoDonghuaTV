<?xml version="1.0" encoding="utf-8"?>
<!--
  Focus style for the secondary pill row above the scrub bar.

  Also from the Amazon Prime Video TV player: a dark translucent plate with a
  faint edge, used for the things that are worth naming but not worth a
  permanent slot in the glyph row. Fully rounded, because the reference draws
  them as capsules.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#66121820" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>

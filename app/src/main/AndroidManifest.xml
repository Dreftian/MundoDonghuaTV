<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        RECORD_AUDIO used to be declared here and was never used: there is no
        MediaRecorder, no AudioRecord and no onPermissionRequest anywhere in the
        app. It is a dangerous runtime permission, so it showed up in system
        settings and in the install screen as "can record audio" for an app that
        only plays video. Removed.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.picture_in_picture"
        android:required="false" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.DonghuaTV"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale"
            android:theme="@style/Theme.DonghuaTV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".player.PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|density|fontScale"
            android:theme="@style/Theme.Player" />

        <service
            android:name=".player.PlayerA11yService"
            android:exported="false"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/player_a11y" />
        </service>

    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!--
  The history glyph for the top navigation bar.

  Drawn as a vector here rather than pulled in from `material-icons-extended`:
  the release build has `isMinifyEnabled = false`, so that library would dex every
  icon in it, the eight hundred this app never draws included, and ship all of
  them. One glyph is not worth that.

  This is Material's own history path, so it sits in the same family as the Home,
  Star, PlayArrow and Search glyphs the bar already uses, at the same 24dp grid.
  The shape matters as much as the size: the clock is open at the top left with
  the arrow head in the gap, which is what reads as "go back to" rather than
  "browse", and a plain clock face would not have told this entry apart from the
  rest of the bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

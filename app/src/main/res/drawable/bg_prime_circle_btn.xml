<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#F47521" />
            <stroke
                android:width="3dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#E06412" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Opaque enough to stay readable over a bright frame. The previous value
         let the video show through, which made the -10/+10 buttons disappear
         on light scenes while staying invisible on dark ones. -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#B3121822" />
            <stroke
                android:width="1.5dp"
                android:color="#99FFFFFF" />
        </shape>
    </item>
</selector>

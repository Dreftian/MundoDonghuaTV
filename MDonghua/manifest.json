{
  "manifest_version": 3,
  "name": "MDonghua — Reproductor Nativo",
  "version": "1.1.0",
  "description": "Reemplaza el reproductor Tamamo de mundodonghua.com por un player nativo Video.js + Hls.js, descifrando la key de Nemonic Player en el cliente.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "102",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.mundodonghua.com/*",
    "*://*.mdnemonicplayer.xyz/*",
    "*://*.dailymotion.com/*",
    "*://*.dmcdn.net/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "mdonghua_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mundodonghua.com/*"
      ],
      "js": [
        "crypto.js",
        "vendor/hls.min.js",
        "vendor/video.min.js",
        "content.js"
      ],
      "css": [
        "vendor/video-js.min.css",
        "player.css"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "player.css",
        "vendor/*"
      ],
      "matches": [
        "*://*.mundodonghua.com/*"
      ]
    }
  ]
}

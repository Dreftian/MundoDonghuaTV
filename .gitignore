# ==============================================================================
# Android, Kotlin & Gradle Gitignore
# MundoDonghuaTV - Android TV Application
# ==============================================================================

# Built application files and binaries
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM and Java classes
*.dex
*.class

# Generated build directories
build/
*/build/
app/build/
bin/
gen/
out/

# Gradle files and cache
.gradle/
.kotlin/
.gradletasknamecache
buildOutputCleanup.lock

# Gradle wrapper (ensure wrapper jar is committed)
!gradle/wrapper/gradle-wrapper.jar

# Local configuration files (SDK path, NDK path, developer machine properties)
local.properties

# Proguard / R8 folder generated by build
proguard/

# Log files and crash traces
*.log
*.dump
*.hprof

# Android Studio / IntelliJ IDEA
.idea/
.idea_modules/
*.iml
*.ipr
*.iws
.navigation/
captures/
.externalNativeBuild
.cxx/
cmake/

# Visual Studio Code
.vscode/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Keystore and signing keys
*.jks
*.keystore
keystore/

# Temporary and reverse engineering artifacts / dumps
*.tmp
*.bak
*.swp
*~
debug_extracted/
extracted_current/
extracted_tv_installed/
tools/temp/

# Critical project assets (never ignore web assets and decryptor scripts)
!app/src/main/assets/mdonghua/
!app/src/main/assets/mdonghua/**
